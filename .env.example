PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# DATABASE_URL: Transaction pooler connection URL
# DIRECT_URL: Direct session connection URL for migrations
DATABASE_URL="postgresql://postgres:password@localhost:5432/labourbaba?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@localhost:5432/labourbaba"

# Supabase Auth / Storage (if utilized)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ==============================================================================
# JWT Authentication Secrets (P0 Security Critical)
# ==============================================================================
# In production, secrets MUST be supplied through secure secret management
# (e.g. AWS Secrets Manager, Vault, Doppler, GCP Secret Manager).
# NEVER hard-code secrets, commit secrets to Git, or use default fallback strings.
#
# Requirements:
# - JWT_ACCESS_SECRET: Signs short-lived access tokens (1 hour).
# - JWT_REFRESH_SECRET: Signs long-lived refresh tokens (7 days).
# - Access and refresh secrets MUST be cryptographically distinct.
# - Minimum length: 32 characters (HMAC key security requirement).
# Generate using:
#   openssl rand -hex 32
# ==============================================================================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Distributed Redis / Upstash Cache & Rate Limiting
REDIS_URL="rediss://default:<password>@<host>:6379"
REDIS_TOKEN=
UPSTASH_REDIS_URL=

# SMS Provider Configuration
# Allowed values: "mock" (local dev/testing only), "twilio", "http"
# NOTE: In production (NODE_ENV=production), "mock" is strictly prohibited.
SMS_PROVIDER=mock
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_CLEANUP_RETENTION_DAYS=7

# Twilio Credentials (Required if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Generic HTTP SMS Gateway (Required if SMS_PROVIDER=http)
GENERIC_SMS_API_URL=
GENERIC_SMS_API_KEY=

# CORS & Client Application URLs
FRONT_END_URL=http://localhost:3000
APP_URL=http://localhost:3001

# ==============================================================================
# Razorpay Payment Provider (Issue #11 — P0 Security Fix)
# ==============================================================================
# Required for real payment order creation. Without these, payment order creation
# will fail in production.
#
# Obtain from: https://dashboard.razorpay.com → Settings → API Keys
#
# In test/development mode: use Razorpay test keys (rzp_test_...).
# In production mode: use Razorpay live keys (rzp_live_...).
# Production WILL fail startup if these are missing or blank.
#
# NEVER commit real credentials. Use a secret manager (Vault, Doppler, etc.)
# ==============================================================================
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE

# RAZORPAY_WEBHOOK_SECRET: Set in Razorpay Dashboard → Webhooks → Secret
# Required for webhook signature verification (Finding #12 fix).
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET_HERE
