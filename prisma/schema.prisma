  wave_number     Int?
  wave_position   Int?
  status          String?         @db.VarChar(30)
  notified_at     DateTime?       @db.Timestamptz(6)
  expires_at      DateTime?       @db.Timestamptz(6)
  responded_at    DateTime?       @db.Timestamptz(6)
