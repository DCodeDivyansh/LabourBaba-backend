generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Worker {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skill_category_id   String                    @db.Uuid
  phone               String                    @unique @db.VarChar(20)
  skill_type          String                    @db.VarChar(100)
  worker_score        Decimal?                  @default(5.0) @db.Decimal(4, 2)
  is_online           Boolean?                  @default(false)
  aadhaar_last4       String?                   @db.Char(4)
  verification_status String?                   @default("pending") @db.VarChar(30)
  decline_count       Int?                      @default(0)
  timeout_count       Int?                      @default(0)
  device_token        String?
  location_geo        Unsupported("geography")?
  deleted_at          DateTime?                 @db.Timestamptz(6)
  password            String
  name                String
  booking             booking[]
  conversation        conversation[]
  job_dispatch        job_dispatch[]
  notification        notification[]
  review              review[]
  skill_category      skill_category            @relation(fields: [skill_category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_worker_skill_category")
  worker_analytics    worker_analytics?
  worker_device       worker_device[]
  worker_document     worker_document[]
  worker_location     worker_location[]

  @@index([location_geo], map: "idx_worker_location", type: Gist)
  @@index([is_online], map: "idx_worker_online")
  @@map("worker")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model booking {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id          String          @db.Uuid
  requirement_id  String          @db.Uuid
  worker_id       String          @db.Uuid
  customer_id     String          @db.Uuid
  status          String?         @db.VarChar(30)
  otp_hash                String?
  otp_verified            Boolean?        @default(false)
  otp_expires_at          DateTime?       @db.Timestamptz(6)
  otp_attempts            Int?            @default(0)
  otp_locked_at           DateTime?       @db.Timestamptz(6)
  otp_consumed_at         DateTime?       @db.Timestamptz(6)
  verified_at             DateTime?       @db.Timestamptz(6)
  verified_by             String?         @db.VarChar(100)
  started_at              DateTime?       @db.Timestamptz(6)
  completion_requested_at DateTime?       @db.Timestamptz(6)
  completed_at            DateTime?       @db.Timestamptz(6)
  cancelled_at            DateTime?       @db.Timestamptz(6)
  cancelled_by            String?         @db.VarChar(100)
  cancellation_reason     String?         @db.Text
  confirmed_at            DateTime?       @db.Timestamptz(6)
  confirmed_by            String?         @db.VarChar(100)
  created_at              DateTime        @default(now()) @db.Timestamp(6)
  updated_at              DateTime        @default(now()) @db.Timestamp(6)
  customer                customer        @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_booking_customer")
  job                     job             @relation(fields: [job_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_booking_job")
  job_requirement         job_requirement @relation(fields: [requirement_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_booking_requirement")
  worker                  Worker          @relation(fields: [worker_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_booking_worker")
  conversation            conversation?
  payment                 payment?
  review                  review?
  booking_transition      booking_transition[]

  @@unique([requirement_id, worker_id], map: "uniq_booking_requirement_worker")
  @@index([customer_id], map: "idx_booking_customer")
  @@index([job_id], map: "idx_booking_job")
  @@index([worker_id], map: "idx_booking_worker")
  @@index([status], map: "idx_booking_status")
}

/// Durable audit history for all Booking state machine transitions.
/// Recorded transactionally in the same DB transaction as the status update.
model booking_transition {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id  String   @db.Uuid
  from_status String   @db.VarChar(30)
  to_status   String   @db.VarChar(30)
  action      String   @db.VarChar(50)
  actor_type  String   @db.VarChar(30)
  actor_id    String?  @db.VarChar(100)
  reason      String?  @db.Text
  metadata    Json?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  booking     booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transition_booking")

  @@index([booking_id, created_at], map: "idx_booking_transition_booking_id")
  @@map("booking_transition")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model job {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id     String                    @db.Uuid
  latitude        Float?
  longitude       Float?
  location_geo    Unsupported("geography")?
  location        String?
  status          String?                   @db.VarChar(30)
  dispatch_status String?                   @db.VarChar(30)
  created_at      DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?                 @default(now()) @db.Timestamptz(6)
  cancelled_at    DateTime?                 @db.Timestamptz(6)
  cancelled_by    String?                   @db.VarChar(100)
  completed_at    DateTime?                 @db.Timestamptz(6)
  deleted_at      DateTime?                 @db.Timestamptz(6)
  booking         booking[]
  customer        customer                  @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_job_customer")
  job_requirement job_requirement[]
  notification    notification[]
  job_transition  job_transition[]

  @@index([customer_id], map: "idx_job_customer")
  @@index([status, customer_id], map: "idx_job_status_customer")
  @@index([location_geo], map: "idx_job_location", type: Gist)
}

/// Durable audit history for all Job state machine transitions.
/// Recorded transactionally in the same DB transaction as the status update.
model job_transition {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id      String   @db.Uuid
  from_status String   @db.VarChar(30)
  to_status   String   @db.VarChar(30)
  action      String   @db.VarChar(50)
  actor_type  String   @db.VarChar(30)
  actor_id    String?  @db.VarChar(100)
  reason      String?  @db.Text
  metadata    Json?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  job         job      @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transition_job")

  @@index([job_id, created_at], map: "idx_job_transition_job_id")
  @@map("job_transition")
}

model payment {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id          String  @unique @db.Uuid
  razorpay_order_id   String? @unique @db.VarChar(255)
  /// Razorpay payment entity ID — populated by webhook after payment capture.
  /// Null until provider confirms actual money movement.
  razorpay_payment_id String? @db.VarChar(255)
  status              String? @db.VarChar(30)
  /// Amount in paise (Indian smallest currency unit). rate_per_day (rupees) × 100.
  amount              Int?
  /// ISO 4217 currency code. Always INR for LabourBaba.
  currency            String  @default("INR") @db.VarChar(10)
  /// Idempotency key = booking_id. Enforces one payment order per booking.
  idempotency_key     String? @unique @db.VarChar(255)
  booking             booking @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payment_booking")
}

/// Tracks every Razorpay webhook event received for replay/idempotency protection.
///
/// The (provider, providerEventId) unique constraint is the authoritative database-level
/// guard against duplicate webhook processing. It is safe under:
///   - provider retry / multiple HTTP deliveries of the same event,
///   - multiple running application instances,
///   - concurrent requests carrying the same event,
///   - process restarts.
///
/// Event lifecycle:
///   PROCESSING → the event was atomically claimed; business processing is in progress.
///   PROCESSED  → the business transition committed successfully.
///   FAILED     → processing failed after claim; the event can be investigated.
///   DUPLICATE  → the unique constraint rejected a second claim; already processed.
///
/// Idempotency identity per event type (Razorpay):
///   payment.captured → providerEventId = payment entity ID (pay_xxx)
///   payment.failed   → providerEventId = orderId + ":failed"
///   other events     → providerEventId = orderId + ":" + eventType
///
/// The payment entity ID (pay_xxx) is stable: Razorpay reuses the same ID on retries.
/// Using orderId+":failed" avoids colliding with a later captured payment on the same order.
model PaymentWebhookEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// "razorpay" — identifies the payment provider.
  provider        String    @db.VarChar(50)
  /// Stable deterministic identifier for this logical provider event.
  /// See model comment for the identity scheme per event type.
  providerEventId String    @db.VarChar(512)
  eventType       String    @db.VarChar(100)
  /// PROCESSING | PROCESSED | FAILED
  status          String    @db.VarChar(30)
  failureReason   String?
  receivedAt      DateTime  @default(now()) @db.Timestamptz(6)
  processedAt     DateTime? @db.Timestamptz(6)

  /// Database-level uniqueness: one row per (provider, event identity).
  /// Concurrent INSERTs of the same event ID will fail with a unique constraint
  /// violation (Prisma P2002), which the service layer interprets as a safe duplicate.
  @@unique([provider, providerEventId])
  @@index([receivedAt], map: "idx_webhook_event_received_at")
  @@map("payment_webhook_event")
}

model review {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id  String   @unique(map: "uniq_review_booking") @db.Uuid
  worker_id   String   @db.Uuid
  customer_id String   @db.Uuid
  rating      Decimal? @db.Decimal(2, 1)
  comment     String?
  booking     booking  @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_review_booking")
  customer    customer @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_review_customer")
  worker      Worker   @relation(fields: [worker_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_review_worker")

  @@index([customer_id], map: "idx_review_customer")
  @@index([worker_id], map: "idx_review_worker")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model conversation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id  String    @unique @db.Uuid
  worker_id   String    @db.Uuid
  customer_id String    @db.Uuid
  booking     booking   @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_conversation_booking")
  customer    customer  @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_conversation_customer")
  worker      Worker    @relation(fields: [worker_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_conversation_worker")
  message     message[]
}

model customer {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone        String         @unique @db.VarChar(20)
  name         String         @db.VarChar(150)
  created_at   DateTime?      @default(now()) @db.Timestamptz(6)
  deleted_at   DateTime?      @db.Timestamptz(6)
  password     String         @db.VarChar(255)
  booking      booking[]
  conversation conversation[]
  job          job[]
  review       review[]
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model job_dispatch {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
